# ==============================================================================
# ALDRI.SHOP - CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS (MongoDB Atlas / Self-Hosted)
# ------------------------------------------------------------------------------
# URI de conexión a tu base de datos MongoDB.
# Formato: mongodb+srv://<USUARIO>:<PASSWORD>@<CLUSTER>.mongodb.net/<DB_NAME>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://tu_usuario:tu_password@cluster0.mongodb.net/aldri_shop?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. ALMACENAMIENTO DE IMÁGENES Y VIDEOS (ImageKit.io)
# ------------------------------------------------------------------------------
# Obtenidas en tu panel de ImageKit (Developer Options / API Keys)
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/tu_endpoint_id
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=public_tu_clave_publica_aqui==
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/tu_endpoint_id
IMAGEKIT_PUBLIC_KEY=public_tu_clave_publica_aqui==
IMAGEKIT_PRIVATE_KEY=private_tu_clave_privada_aqui==

# ------------------------------------------------------------------------------
# 3. CORREO Y NOTIFICACIONES (SMTP - Órdenes, 2FA y Contacto)
# ------------------------------------------------------------------------------
# Configuración del servidor de correo saliente (Gmail, Resend, Sendgrid, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=contacto@aldri.shop
SMTP_PASS=tu_app_password_o_contraseña_smtp
SMTP_FROM="Aldri Shop" <contacto@aldri.shop>

# Correos receptores para alertas de pedidos, contacto y códigos 2FA (separados por coma)
ADMIN_EMAILS=admin@aldri.shop,notificaciones@aldri.shop
ADMIN_EMAIL=admin@aldri.shop

# ------------------------------------------------------------------------------
# 4. SEGURIDAD Y PANEL DE ADMINISTRACIÓN
# ------------------------------------------------------------------------------
# Contraseña de acceso maestro al panel administrativo (/admin)
ADMIN_PASSWORD=TuPasswordSeguraAdmin2026

# ------------------------------------------------------------------------------
# 5. AUTENTICACIÓN (Auth.js / NextAuth v5)
# ------------------------------------------------------------------------------
# Genera un secreto seguro con: openssl rand -base64 32
AUTH_SECRET=tu_secreto_generado_hex_o_base64_de_32_caracteres_minimo
NEXTAUTH_URL=https://aldri.shop

# Proveedores OAuth opcionales (GitHub / Google)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ------------------------------------------------------------------------------
# 6. INTELIGENCIA ARTIFICIAL (Google Gemini API)
# ------------------------------------------------------------------------------
# Clave de API para el asistente virtual / chat y generación de artículos de blog
GEMINI_API_KEY=tu_gemini_api_key_aqui

# ------------------------------------------------------------------------------
# 7. DOMINIO Y CONFIGURACIÓN DEL SITIO (SEO, Sitemaps, Robots)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://aldri.shop

# ------------------------------------------------------------------------------
# 8. WEBHOOKS Y PASARELAS DE PAGO (Opcional / Integraciones futuras)
# ------------------------------------------------------------------------------
# Token secreto para validar webhooks entrantes
WEBHOOK_SECRET=tu_webhook_secret_token_seguro
